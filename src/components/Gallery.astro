const fullImages = await Promise.all(
  photos.map((photo) =>
    getImage({
      src: photo.src,
      width: Math.min(photo.src.width, 1600),
      format: 'webp',
    }),
  ),
);
---

<section
  class="gallery section-pad"
  id="galeria"
  aria-labelledby="gallery-title"
>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <span></span> NA PRÁTICA
        </p>
        <h2 id="gallery-title">
          O resultado fala.
          <br />E faz barulho.
        </h2>
      </div>
      <p>
        Um pouco do que acontece
        <br /> quando a estrutura encontra a emoção.
      </p>
    </div>
    <div class="gallery-grid">
      {photos.slice(0, 6).map((photo, i) => (
        <button
          class="gallery-card"
          type="button"
          data-photo={fullImages[i].src}
          data-caption={photo.alt}
          aria-label={`Ampliar: ${photo.alt}`}
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            width={760}
            widths={[360, 600, 760]}
            sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
            format="webp"
            loading="lazy"
          />
          <span class="gallery-overlay">
            <span>
              <span class="photo-category">{photo.category}</span>
              <strong>{photo.title}</strong>
            </span>
            <span class="photo-arrow">
              <Icon name="diagonal" size={20} />
            </span>
          </span>
        </button>
      ))}
    </div>
    <details class="more-photos">
      <summary class="button button--outline">
        <span class="more-label">Ver mais eventos</span>
        <span class="less-label">Ver menos eventos</span>
        <Icon name="down" size={18} />
      </summary>
      <div class="gallery-grid extra-gallery">
        {photos.slice(6).map((photo, i) => (
          <button
            class="gallery-card"
            type="button"
            data-photo={fullImages[i + 6].src}
            data-caption={photo.alt}
            aria-label={`Ampliar: ${photo.alt}`}
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              width={760}
              format="webp"
              loading="lazy"
            />
            <span class="gallery-overlay">
              <span>
                <span class="photo-category">{photo.category}</span>
                <strong>{photo.title}</strong>
              </span>
              <span class="photo-arrow">
                <Icon name="diagonal" size={20} />
              </span>
            </span>
          </button>
        ))}
      </div>
    </details>
  </div>
</section>
<dialog class="lightbox" aria-label="Imagem do evento ampliada">
  <button class="lightbox-close" type="button" aria-label="Fechar imagem">
    <Icon name="close" size={26} />
  </button>
  <img class="lightbox-image" alt="" />
  <p class="lightbox-caption"></p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const image = document.querySelector<HTMLImageElement>('.lightbox-image');
  const caption = document.querySelector<HTMLElement>('.lightbox-caption');
  if (dialog && image && caption) {
    document
      .querySelectorAll<HTMLButtonElement>('[data-photo]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          image.src = button.dataset.photo ?? '';
          image.alt = button.dataset.caption ?? '';
          caption.textContent = image.alt;
          dialog.showModal();
          document.body.classList.add('modal-open');
        });
      });
    dialog
      .querySelector('button')
      ?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () =>
      document.body.classList.remove('modal-open'),
    );
  }
</script>
